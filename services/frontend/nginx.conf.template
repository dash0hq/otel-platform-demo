server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Handle React SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API calls to the todo service
    location /todos {
        proxy_pass http://${TODO_SERVICE_HOST}:${TODO_SERVICE_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy notifications API calls to the notification service
    location /notifications {
        proxy_pass http://notification-service:3002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Browser OTLP export, proxied to the collector so no ingest token ships in the JS
    # bundle. Two details are load-bearing:
    #
    #   - the whole prefix is proxied, not just /v1/traces: the SDK also posts page
    #     views, web vitals and errors to /v1/logs, which the SPA catch-all would
    #     otherwise answer with index.html and lose silently;
    #   - it is mounted under /telemetry/ because the SDK skips instrumenting requests
    #     whose URL starts with its endpoint -- a bare-origin endpoint would suppress
    #     spans for /todos too.
    #
    # The trailing slash on proxy_pass strips /telemetry, so /telemetry/v1/traces
    # arrives as /v1/traces.
    location /telemetry/ {
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '*';
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS';
            add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization';
            add_header 'Access-Control-Max-Age' 1728000;
            add_header 'Content-Type' 'text/plain; charset=utf-8';
            add_header 'Content-Length' 0;
            return 204;
        }
        
        proxy_pass http://${OTEL_COLLECTOR_HOST}:${OTEL_COLLECTOR_PORT}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization' always;
    }
}