# You can get this data from Dash0's settings screens

DASH0_AUTH_TOKEN="auth_abc123"
DASH0_DATASET="default"

DASH0_ENDPOINT_OTLP_GRPC_HOSTNAME="ingress.eu-west-1.aws.dash0.com"
DASH0_ENDPOINT_OTLP_GRPC_PORT="4317"
DASH0_ENDPOINT_OTLP_HTTP_HOSTNAME="ingress.eu-west-1.aws.dash0.com"
DASH0_ENDPOINT_OTLP_HTTP_PORT="443"

DASH0_API_URL="https://api.eu-west-1.aws.dash0.com"

# Backstage's "Ask Dash0" chat page. Leave these blank to run the demo without it
# -- 01_start-demo.sh warns and the backend skips the plugin instead of failing.
# DASH0_MCP_URL defaults to https://api.eu-west-1.aws.dash0.com/mcp when unset.
DASH0_MCP_URL=""
DASH0_MCP_TOKEN=""
ANTHROPIC_API_KEY=""

# Token the chat uses to call Backstage's own MCP actions endpoint on localhost.
# Leave blank -- 01_start-demo.sh generates a fresh one per run. Set it only if
# you want a stable value (e.g. to point another MCP client at the endpoint).
BACKSTAGE_MCP_TOKEN=""

OPENTELEMETRY_COLLECTOR_CONTAINER_IMAGE="otel/opentelemetry-collector-contrib:0.126.0"
OPENTELEMETRY_COLLECTOR_LOG_LEVEL="info"
